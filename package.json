{
  "name": "dirvo",
  "version": "0.1.0",
  "description": "Explains mystery folders on Windows",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/build-icons.mjs",
    "pack": "electron-vite build && electron-builder --win --dir",
    "dist": "npm run typecheck && electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.81.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "productName": "Dirvo",
  "author": "malsaaaa",
  "homepage": "https://github.com/malsaaaa/Dirvo",
  "repository": {
    "type": "git",
    "url": "https://github.com/malsaaaa/Dirvo.git"
  },
  "build": {
    "appId": "com.dirvo.app",
    "productName": "Dirvo",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "resources/icon.ico",
      "out/**/*",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "executableName": "Dirvo"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dirvo",
      "uninstallDisplayName": "Dirvo",
      "artifactName": "Dirvo-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
